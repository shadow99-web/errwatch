# ─── errwatch configuration ────────────────────────────────────
# Copy this file to .env and fill in your real values.
# .env is gitignored — .env.example is not.

# Discord webhook URL for error notifications (optional but recommended)
# Create in Discord: Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
ERRWATCH_WEBHOOK=https://discord.com/api/webhooks/000000000000000000/your_webhook_token_here

# Discord user ID to DM on CriticalError (optional)
# Enable Developer Mode: User Settings → Advanced → Developer Mode
# Right-click your name → Copy User ID
ERRWATCH_OWNER_ID=000000000000000000
